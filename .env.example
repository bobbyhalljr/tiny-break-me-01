# The secret Polly guards. Pick your own. It never goes in the repo.
BREAK_ME_COUPON=PICK-YOUR-OWN-CODE

# One model key. Any OpenAI-compatible endpoint works.
# Checked in this order: GROQ_API_KEY, AI_GATEWAY_API_KEY, OPENAI_API_KEY, XAI_API_KEY, BREAK_ME_BASE_URL.
# Groq has a free tier: https://console.groq.com
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=
# XAI_API_KEY=        (also set BREAK_ME_MODEL)

# Optional overrides
# BREAK_ME_MODEL=gpt-4.1-nano
# BREAK_ME_BASE_URL=http://127.0.0.1:8080/v1   (a local llama.cpp or Ollama server, no key needed)
